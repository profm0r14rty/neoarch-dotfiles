# Save a copy as ~/.config/sway/config.d/90-monitors.conf after replacing output names.
# Discover names and available modes with:
#   swaymsg -t get_outputs
#   swaymsg -t get_outputs | jq '.[] | {name, active, modes}'
# Do not copy these example names unless they match your actual outputs.

# Example: laptop display on the left, 1920x1080 external display on the right.
output eDP-1 mode 1920x1080@60Hz position 0 0 scale 1
output HDMI-A-1 mode 1920x1080@60Hz position 1920 0 scale 1

# Prefer the laptop display for workspaces 1–5 and the external for 6–10.
# Each rule lists a fallback output second for when a display is disconnected.
workspace 1 output eDP-1 HDMI-A-1
workspace 2 output eDP-1 HDMI-A-1
workspace 3 output eDP-1 HDMI-A-1
workspace 4 output eDP-1 HDMI-A-1
workspace 5 output eDP-1 HDMI-A-1
workspace 6 output HDMI-A-1 eDP-1
workspace 7 output HDMI-A-1 eDP-1
workspace 8 output HDMI-A-1 eDP-1
workspace 9 output HDMI-A-1 eDP-1
workspace 10 output HDMI-A-1 eDP-1
