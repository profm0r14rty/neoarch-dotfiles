# Example dual-monitor layout for Neoarch dotfiles.
#
# Copy this to ~/.config/sway/config.d/99-outputs.conf
# and adapt the output names and positions for your hardware.
#
# Find output names using:
# swaymsg -t get_outputs

# Laptop display: left
output eDP-1 pos 0 0

# External display: right
output HDMI-A-1 pos 1920 0
